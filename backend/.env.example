# Copy this file to .env and fill in real values. Never commit .env.

# --- MongoDB (primary evidence store) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=sih26155

# --- Vector DB (RAG) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=security-knowledge-base
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# --- Local LLM (Ollama) ---
# Not installed by default. Install Ollama and run `ollama pull qwen2.5:3b-instruct`
# to enable real AI explanations/remediation. Until then, the AI service reports
# AI_UNAVAILABLE rather than fabricating output.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# --- Hyperledger Fabric ---
FABRIC_GATEWAY_SIDECAR_URL=http://localhost:4001
FABRIC_CHANNEL=securityaudit
FABRIC_CHAINCODE=security-audit-chaincode
FABRIC_MSP_ID=Org1MSP

# --- File storage ---
UPLOAD_STORAGE_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=20

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
